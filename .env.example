# Application
NEXT_PUBLIC_APP_NAME="ÉLIXIR BEAUTÉ"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="ru"

# Neon Serverless PostgreSQL
# Create a free project at https://neon.tech and paste connection string here:
DATABASE_URL="postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate with: node -e \"require('crypto').randomBytes(32).toString('base64')|console.log\""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (Better Auth)
# Create credentials at: https://console.cloud.google.com -> APIs & Services -> Credentials
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# Telegram Bot / Mini App (Phase 3)
# TELEGRAM_BOT_TOKEN="your_bot_token_here"

# Stripe Test Mode Payment (Split / Test Pay)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
STRIPE_SECRET_KEY="sk_test_your_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
